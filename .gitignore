# macOS
.DS_Store

# Secrets & session data (never commit — see AGENTS.md)
.env
*.env
cookies*.txt
session*.json
credentials*.json

# Excel lock files
~$*.xlsx

# Future code: Python / Node
__pycache__/
*.pyc
.venv/
node_modules/

# Large local media (never commit)
*.mp4

# Assets: keep the spec workbook, the requirement screenshots and the UI dumps;
# ignore anything else generated locally.
assets/*
!assets/*.xlsx
!assets/*.png
!assets/*.xml
